      "id": "9a043243-2134-452b-924e-d318dd66acc0",
      "comment": "",
      "command": "verifyText",
      "target": "css=.list-unstyled > li:nth-child(1)",
      "targets": [
        ["css=.list-unstyled > li:nth-child(1)", "css:finder"],
        ["xpath=//div/ul/li", "xpath:position"],
        ["xpath=//li[contains(.,' (678) 813-1KMS')]", "xpath:innerText"]
      ],
      "value": "(678) 813-1KMS"
    }, {
      "id": "8880650b-6ae5-43bd-bd0e-04c6f39955e2",
      "comment": "",
