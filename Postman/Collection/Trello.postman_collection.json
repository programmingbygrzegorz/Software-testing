    {
      "name": "Tworzenie nowej tablicy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let resBody = pm.response.json();\r",
              "\r",
              "pm.test(\"Weryfikacja kodu odpowiedzi - 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.collectionVariables.set(\"boardId\", resBody.id); // Zapisanie ID tablicy do zmiennej kolekcji\r",
              "});\r",
              "\r",
              "pm.test(\"Weryfikacja nazwy tablicy\", function () {\r",
              "    pm.expect(resBody.name).to.eql(pm.collectionVariables.get(\"boardTitle\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
